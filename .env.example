# Telegram bot token from @BotFather
TG_SPACE_BOT_TOKEN=replace_me
# Optional: only used when switching to webhooks
TG_SPACE_BOT_WEBHOOK_URL=

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace_me
SUPABASE_TABLE=files

# Storage groups: add the bot as an admin in each group and paste its chat id
TG_STORAGE_CHAT_DOCUMENT=
TG_STORAGE_CHAT_IMAGE=
TG_STORAGE_CHAT_VIDEO=
TG_STORAGE_CHAT_AUDIO=
TG_STORAGE_CHAT_ARCHIVE=
TG_STORAGE_CHAT_OTHER=

# Emergency group (e.g. "TG-Storage-Chat-Fallback"): any file whose registration
# in Supabase fails is copied here instead of the library, so nothing is lost.
# It is also offered in the «انضمام للمجموعات» gate like the other groups.
TG_STORAGE_CHAT_FALLBACK=

# Content fingerprint: files up to this many bytes get a SHA-256 hash.
# Telegram lets a bot download at most 20 MB, so keep it at or below that.
HASH_MAX_BYTES=20971520

# Where the list of held files is kept (JSON). The Telegram Bot API cannot read a
# chat's history, so this file is what makes «🔧 إصلاح» possible. On Render, point
# it at a mounted persistent disk (e.g. /var/data/pending_files.json) so it
# survives a restart; an ephemeral path loses the list but not the files.
PENDING_STORE_PATH=data/pending_files.json

# Keep-alive HTTP server (Render sets PORT automatically)
PORT=8000

# Storage-group gate: one-time invites + automatic admin promotion.
# No password: access follows ALLOWED_USER_IDS below (OWNER_ID is optional and
# simply adds one more allowed id).
OWNER_ID=

# Optional runtime tuning
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
PAGE_SIZE=10
# Comma-separated Telegram user ids; empty means the bot is open to everybody
ALLOWED_USER_IDS=
