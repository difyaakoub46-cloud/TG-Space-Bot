# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE

# Telegram Storage Channel/Group IDs (Physical Backend Storage)
STORAGE_DOCUMENTS_CHAT_ID=-1001234567890
STORAGE_MEDIA_CHAT_ID=-1001234567891
STORAGE_AUDIO_CHAT_ID=-1001234567892
STORAGE_ARCHIVES_CHAT_ID=-1001234567893
STORAGE_DEFAULT_CHAT_ID=-1001234567890

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional Direct PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project-id.supabase.co:5432/postgres

# Bot Administrators (Comma-separated Telegram User IDs)
ADMIN_IDS=123456789,987654321

# Pagination & Limits
DEFAULT_PAGE_SIZE=5
MAX_SEARCH_RESULTS=10
