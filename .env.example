# ── Telegram bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:replace-with-the-token-from-BotFather

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://vzsbnldehccitrgbsjez.supabase.co
SUPABASE_KEY=replace-with-the-service-role-key
SUPABASE_TABLE=files

# ── Telegram storage groups (negative ids, bot must be admin in every group) ─
STORAGE_CHAT_DOCUMENTS=-1000000000001
STORAGE_CHAT_MEDIA=-1000000000002
STORAGE_CHAT_AUDIO=-1000000000003
STORAGE_CHAT_ARCHIVES=-1000000000004
STORAGE_CHAT_DEFAULT=-1000000000005

# ── Access & behaviour ──────────────────────────────────────────────────────
# Comma separated Telegram user ids. Empty = anyone can use the bot.
ALLOWED_USER_IDS=
PAGE_SIZE=6
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
